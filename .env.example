# AITUNNEL (OpenAI-compatible API)
AITUNNEL_API_KEY=sk-your-key-here
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_MODEL=gpt-4o-mini
AITUNNEL_TEMPERATURE=0.2
AITUNNEL_MAX_TOKENS=2500
AITUNNEL_TIMEOUT=60

# Application
DATABASE_PATH=data/app.db
DATABASE_URL=
CALLPILOT_DB_PATH=call-center/data/call_center.db
CALLPILOT_DB_URL=
LOG_LEVEL=INFO
DEBUG=false

# Speech-to-Text (Whisper-compatible API)
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1
STT_TIMEOUT=120
AUDIO_MAX_BYTES=52428800
AUDIO_URL_ALLOWLIST=
AUDIO_ENCRYPTION_KEY=
AUDIO_KEY_PATH=data/audio.key
AUDIO_RETENTION_DAYS=30

# Schema: true for local start; false after `alembic upgrade head` in production
SCHEMA_AUTO_CREATE=true

# Public demo: disable upload and LLM recalculation
DEMO_MODE=false

# Lead email notifications (Mail.ru: smtp.mail.ru, port 465, SSL)
MAIL_ENABLED=false
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_NOTIFY_TO=aillix@mail.ru
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_TIMEOUT=15

# PII vault (set a long random value in production)
PII_VAULT_KEY=
PII_VAULT_PATH=data/pii_vault.db
PII_VAULT_TTL_SECONDS=86400

# CRM delivery: webhook | bitrix24 | amo
CRM_ENABLED=false
CRM_PROVIDER=webhook
CRM_TIMEOUT=10
CRM_MAX_ATTEMPTS=3
# Optional JSON map: {"qa_score": "UF_CRM_...", "summary": "UF_CRM_..."}
# For amoCRM values must be numeric custom-field IDs.
CRM_FIELD_MAP=
CRM_OUTBOX_PATH=data/crm_outbox.db

# Universal signed webhook (CRM_PROVIDER=webhook)
CRM_WEBHOOK_ENABLED=false
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Bitrix24 inbound webhook (CRM_PROVIDER=bitrix24)
CRM_BITRIX24_WEBHOOK_URL=
CRM_BITRIX24_ENTITY=lead
CRM_BITRIX24_SOURCE_ID=
CRM_BITRIX24_ASSIGNED_BY_ID=0

# amoCRM API v4 (CRM_PROVIDER=amo)
CRM_AMO_BASE_URL=
CRM_AMO_TOKEN=
CRM_AMO_PIPELINE_ID=0
CRM_AMO_STATUS_ID=0
CRM_AMO_RESPONSIBLE_USER_ID=0

# Oktell call export (paths depend on the PBX version)
OKTELL_ENABLED=false
OKTELL_BASE_URL=
OKTELL_API_KEY=
OKTELL_USERNAME=
OKTELL_PASSWORD=
OKTELL_CALLS_PATH=/api/v1/calls
OKTELL_PAGE_SIZE=100
OKTELL_TIMEOUT=30
OKTELL_SINCE_PARAM=from
OKTELL_RECORDING_ALLOWLIST=
OKTELL_VERIFY_SSL=true

# Background jobs
CALLPILOT_QUEUE_URL=sqlite:///call-center/data/queue.db
CALLPILOT_ASYNC_UPLOAD=false
OKTELL_SYNC_INTERVAL_SECONDS=300
CRM_DISPATCH_INTERVAL_SECONDS=60
RETENTION_INTERVAL_SECONDS=86400
